# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/

# Environment variables & secrets
.env
*.env.*

# Testing & cache
.pytest_cache/
.coverage
htmlcov/

# Local databases, storage, checkpoints & event logs
storage/*.db*
storage/*.sqlite*
storage/market_intel.db*
storage/checkpoints/*
storage/chroma/*
storage/logs/*
storage/audio/*
storage/*.wav
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.jsonl
storage/logs/*.jsonl
storage/logs/*.log
exports/output/*
backups/
scratch_tail.txt

# Keep gitkeeps
!storage/checkpoints/.gitkeep
!storage/chroma/.gitkeep
!storage/logs/.gitkeep
!exports/output/.gitkeep
