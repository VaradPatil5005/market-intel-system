# === Database ===
DATABASE_URL=sqlite:///storage/market_intel.db

# === Paths ===
CHECKPOINT_DIR=storage/checkpoints
CHROMA_DIR=storage/chroma
EXPORT_DIR=exports/output
LOG_DIR=storage/logs

# === Retry / resilience ===
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# === Ingestion sources (comma-separated RSS/news URLs). Leave blank to use mock/seed data. ===
NEWS_RSS_FEEDS=
COMPANY_WATCHLIST=OpenAI,Anthropic,Nvidia,Microsoft,Google

# === Confidence thresholds ===
LOW_CONFIDENCE_THRESHOLD=0.55
HUMAN_REVIEW_REQUIRED_BELOW=0.65

# === Optional API keys (system runs fully in mock mode without these) ===
NEWSAPI_KEY=
OPENAI_API_KEY=

# === Tier 1: embedding-based entity resolution + ChromaDB RAG ===
# Both default to on and fall back automatically to the classical method
# (fuzzy-match / TF-IDF) if the model/package can't be loaded, so these are
# safe to leave as-is even before you've installed the heavier ML deps.
USE_EMBEDDING_ENTITY_RESOLUTION=true
ENTITY_EMBEDDING_SIMILARITY_THRESHOLD=0.75
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_CHROMA_RAG=true

# === Tier 1: trend anomaly detection ===
TREND_ANOMALY_Z_THRESHOLD=2.0
TREND_EWMA_SPAN=5

# === Tier 2: FinBERT sentiment (falls back to lexicon scorer if unavailable) ===
USE_FINBERT_SENTIMENT=true
FINBERT_MODEL_NAME=ProsusAI/finbert

# === Tier 2: forecasting ===
# Minimum prior sentiment observations an entity needs before the
# forecasting agent will train a model on it (below this: neutral default).
FORECASTING_MIN_OBSERVATIONS=10

# === Tier 3: alerting ===
# Leave ALERT_WEBHOOK_URL blank to log alerts instead of sending them —
# useful for local testing. Paste a Slack "Incoming Webhook" URL (or any
# endpoint that accepts {"text": "..."} as JSON) to enable real alerts.
ALERT_WEBHOOK_URL=
ALERT_CONFIDENCE_THRESHOLD=0.85

# === Tier 3: Playwright ingestion (opt-in; requires extra setup, see README) ===
USE_PLAYWRIGHT_INGESTION=false
PLAYWRIGHT_URLS=
