# =========================================================================
# Market Intelligence System v2 — Environment Variables
# Copy this file to .env and fill in your values.
# All settings have safe offline defaults — the system runs with ZERO
# external services configured (mock/seed mode).
# =========================================================================

# --- Database (SQLite default — no setup required) ---
DATABASE_URL=sqlite:///storage/market_intel.db

# --- Watchlist (comma-separated canonical entity names) ---
COMPANY_WATCHLIST=OpenAI,Anthropic,Nvidia,Microsoft,Google

# =========================================================================
# EXTERNAL APIs (all optional — system degrades gracefully if empty)
# =========================================================================

# OpenAI — enables LLM-quality Reflexion lessons + richer report narratives
OPENAI_API_KEY=

# Anthropic — alternative LLM for lesson generation
ANTHROPIC_API_KEY=

# NewsAPI — premium headline ingestion (free tier: 100 req/day)
NEWSAPI_KEY=

# =========================================================================
# V2: DEEP SEARCH
# =========================================================================

# Set to true to enable autonomous web search on anomaly spikes
ENABLE_DEEP_SEARCH=false

# Provider: "duckduckgo" (free, no key) or "tavily" (better quality, key needed)
DEEP_SEARCH_PROVIDER=duckduckgo

# Only required if DEEP_SEARCH_PROVIDER=tavily
DEEP_SEARCH_API_KEY=

# Max results per entity per search
DEEP_SEARCH_MAX_RESULTS=5

# Only trigger deep search on Z-score anomalies (recommended: true)
DEEP_SEARCH_ON_ANOMALY_ONLY=true

# SEC EDGAR 8-K filing search (always free, no key required)
ENABLE_SEC_EDGAR=true
SEC_EDGAR_LOOKBACK_DAYS=7

# =========================================================================
# V2: PRICE DATA ENRICHMENT (yfinance — free, no key required)
# =========================================================================

PRICE_DATA_ENABLED=false
PRICE_DATA_LOOKBACK_DAYS=30
PRICE_RSI_PERIOD=14

# Bollinger Band parameters
BOLLINGER_BAND_WINDOW=20
BOLLINGER_BAND_STD=2.0

# Enable RSI / BB technical indicator computation (requires price_data_enabled=true)
ENABLE_TECHNICAL_INDICATORS=false

# =========================================================================
# V2: REFLEXION SELF-LEARNING
# =========================================================================

ENABLE_REFLEXION_LEARNING=true
REFLEXION_TOP_K_LESSONS=3
REFLEXION_LESSON_SIMILARITY_THRESHOLD=0.5

# =========================================================================
# V2: GROUNDING GATE
# =========================================================================

ENABLE_GROUNDING_GATE=true
# Tolerance for numeric claim verification (5% = 0.05)
GROUNDING_TOLERANCE_PCT=0.05

# =========================================================================
# V2: LIVE DAEMON
# =========================================================================

ENABLE_LIVE_DAEMON=false
LIVE_POLL_INTERVAL_SECONDS=300
LIVE_DAEMON_RUN_MINI_PIPELINE=true
Z_SCORE_ALERT_THRESHOLD=3.0

# =========================================================================
# V2: ALERTING (multi-channel)
# =========================================================================

# Slack / generic JSON webhook
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Telegram bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_ALERT_TO=

# Confidence threshold for HIGH-priority alerts
ALERT_CONFIDENCE_THRESHOLD=0.85

# =========================================================================
# V2: USER PERSONALIZATION
# =========================================================================

USER_ID=default
USER_RISK_APPETITE=moderate
USER_PREFERRED_DEPTH=standard

# =========================================================================
# V2: MARKET CORRELATION & COUNTERFACTUAL SCENARIOS
# =========================================================================

ENABLE_MARKET_CORRELATION=true
CORRELATION_MIN_OBSERVATIONS=5
ENABLE_COUNTERFACTUAL_SCENARIOS=true

# =========================================================================
# V2: ADAPTIVE CONFIDENCE WEIGHTS
# =========================================================================

# Enable Bayesian weight tuning from historical calibration
ADAPTIVE_CONFIDENCE_WEIGHTS=false

# Cross-source verification: insights with fewer sources than this are auto-flagged
MIN_CROSS_SOURCE_VERIFICATION=2

# =========================================================================
# V1: EXISTING SETTINGS (unchanged)
# =========================================================================

NEWS_RSS_FEEDS=
LOW_CONFIDENCE_THRESHOLD=0.55
HUMAN_REVIEW_REQUIRED_BELOW=0.65
USE_EMBEDDING_ENTITY_RESOLUTION=true
ENTITY_EMBEDDING_SIMILARITY_THRESHOLD=0.75
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_CHROMA_RAG=true
TREND_ANOMALY_Z_THRESHOLD=2.0
TREND_EWMA_SPAN=5
USE_FINBERT_SENTIMENT=true
FINBERT_MODEL_NAME=ProsusAI/finbert
FORECASTING_MIN_OBSERVATIONS=10
USE_PLAYWRIGHT_INGESTION=false
PLAYWRIGHT_URLS=
